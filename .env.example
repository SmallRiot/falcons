# Порт API (в проде он же отдаёт собранный фронт)
PORT=8787
# Порт веб-консоли для админов и тренера (в проде отдаёт console/dist)
CONSOLE_PORT=8788
# Где хранить БД и загруженные скрины
DATA_DIR=./data

# Режим теста в браузере: вход без Telegram + переключатель пользователей.
# В проде ОБЯЗАТЕЛЬНО 0.
DEV_AUTH=1

# Telegram (можно оставить пустым при тестах в вебе — уведомления пишутся в консоль)
BOT_TOKEN=
BOT_USERNAME=
# short name мини-аппа из BotFather (/newapp), для ссылок вида t.me/<bot>/<app>?startapp=...
APP_SHORT_NAME=
# Публичный https-адрес приложения (для кнопки web_app в личке с ботом)
WEBAPP_URL=
# id командного чата (узнать: добавить бота в чат и написать /chatid)
TEAM_CHAT_ID=
# группа с топиками: номер топика для постов бота (узнать: /chatid в нужном топике)
TEAM_THREAD_ID=
# отдельные топики: куда постить тренировки и игры (пусто — в TEAM_THREAD_ID)
TEAM_THREAD_TRAININGS=
TEAM_THREAD_GAMES=
# Telegram id первых админов через запятую — их пускает сразу
ADMIN_IDS=
# Ключ подписи веб-сессий (если пусто — сгенерируется в DATA_DIR/session.key)
SESSION_SECRET=
# 1 = бот сам слушает апдейты (команды /start, /chatid, кнопки одобрения заявок)
BOT_POLLING=0

# Тестовый режим: ВСЕ сообщения бота (личные и в чат) уходят на этот chat id с пометкой «кому». В проде — пусто.
TEST_CHAT_ID=

# «Респект в чате»: комплимент пишет Claude (без ключа — запасной шаблон)
ANTHROPIC_API_KEY=
